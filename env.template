# Copie para .env e ajuste os valores.

# Banco de dados (SQLite local — ver ADR 0007)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessão (obrigatório em produção)
SESSION_SECRET='troque-por-um-segredo-longo-e-aleatorio'

# Admin inicial criado pelo `yarn db:seed`
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='troque-esta-senha'

# Base URL usada pelo axios no client (opcional em dev)
# BASE_URL='http://localhost:3000'

# Somente para a importação única da planilha antiga (yarn db:import-sheets).
# Após importar e validar, revogue estas credenciais.
# GOOGLE_SERVICE_ACCOUNT_EMAIL='service account email'
# GOOGLE_PRIVATE_KEY='private key'
# GOOGLE_SHEET_ID='sheet id'
