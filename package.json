{
  "name": "librosistemo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "testw": "jest --watch",
    "testc": "jest --coverage",
    "test:build": "yarn testcb && next build",
    "testcb": "jest --coverage && rm -rf ./badges/* && jest-coverage-badges --output \"./badges\"",
    "typecheck": "tsc --noEmit",
    "devloop": "concurrently -n dev,types,test -c blue,yellow,magenta \"next dev\" \"tsc --noEmit --watch --preserveWatchOutput\" \"jest --watch\"",
    "ci": "yarn lint --max-warnings 0 && yarn typecheck && yarn testc && yarn build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && yarn db:seed",
    "db:import-sheets": "tsx scripts/import-from-sheets.ts",
    "db:studio": "prisma studio",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "html5-qrcode": "^2.3.8",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-paginate": "^8.3.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "react-webcam": "^7.2.0",
    "styled-components": "^6.5.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.5",
    "jest": "^30.4.2",
    "jest-coverage-badges": "^1.1.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
